# Copier en .rest/.env — lu par les {{$dotenv VAR}} des fichiers .rest.
# Ce fichier ne contient QUE des valeurs de développement.

# Mot de passe du compte d'administration semé (cmd/seed).
# Aucune valeur par défaut côté serveur : c'est SEED_ADMIN_PASSWORD du .env
# de la stack (dira-devops/.env ou dira-devops/dev/.env).
SEED_ADMIN_PASSWORD=

# Secret partagé des routes /internal (valeur du stack de dev).
# En production : CORE_SERVICE_TOKEN du .env de dira-devops.
CORE_SERVICE_TOKEN=dev-only-core-service-token

# Secret du prestataire de paiement simulé (valeur par défaut du code).
MOCK_PAYMENT_SECRET=mock-secret
