# --- socle ---
PORT=8082
ENV=dev
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=dira_core
REDIS_URI=redis://localhost:6379/0
LOCALES_PATH=locales

# ⚠️ LE MÊME que celui des verticales. C'est ce qui leur permet de vérifier un
# jeton LOCALEMENT, sans appeler le socle : une vérification par requête ferait
# de ce service le point de panne unique de toute la plateforme.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
RATE_LIMIT_RPM=120

# ⚠️ VIDE = routes de service FERMÉES. Une porte de service sans serrure vaut
# moins que pas de porte : n'importe qui pourrait débiter le portefeuille de
# n'importe qui.
CORE_SERVICE_TOKEN=

# --- stockage d'objets ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET=dira-core
MINIO_PUBLIC_URL=http://localhost:9000

# --- notifications ---
# Une clé privée RSA tient mal dans une variable d'environnement : la plupart
# des déploiements montent un secret en FICHIER. Les deux vides = aucune
# notification poussée, et c'est dit au démarrage.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# --- paiement ---
MOCK_PAYMENT_SECRET=mock-secret

# FOOD_BASE_URL — l'adresse de la verticale LIVRAISON, pour les rappels que le
# socle lui doit : un paiement de commande abouti, notamment.
#
# ⚠️ VIDE = rappel impossible, et le webhook du prestataire reçoit une erreur
# plutôt qu'un accusé de réception. C'est voulu : répondre « reçu » sans avoir
# prévenu la livraison laisserait une commande payée et jamais confirmée, et le
# prestataire ne réessaierait pas.
FOOD_BASE_URL=http://food-api:8080
